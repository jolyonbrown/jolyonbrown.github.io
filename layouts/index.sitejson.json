{{- $cv := site.Data.cv -}}
{{- $posts := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $posts = $posts | append (dict
      "title" .Title
      "date" (.Date.Format "2006-01-02")
      "url" .Permalink
      "tags" (.Params.tags | default slice)
      "summary" (.Summary | plainify | htmlUnescape | replaceRE `\s+` " " | strings.TrimSpace | truncate 300)
  ) -}}
{{- end -}}
{{- $data := dict
    "about" "Structured data for Jolyon Brown's personal site. Generated by Hugo from the same files as the website."
    "generated" (now.UTC.Format "2006-01-02T15:04:05Z")
    "site" site.Home.Permalink
    "plan" (dict "updated" ((time.AsTime .Params.planUpdated).Format "2006-01-02") "text" (.RawContent | strings.TrimSpace))
    "profile" $cv.profile
    "experience" $cv.experience
    "skills" $cv.skills
    "self_assessment" $cv.self_assessment
    "fit_examples" $cv.fit_examples
    "publications" $cv.publications
    "administeria" site.Data.administeria
    "education" $cv.education
    "projects" site.Data.projects
    "posts" $posts
-}}
{{- $data | jsonify (dict "indent" "  ") -}}
